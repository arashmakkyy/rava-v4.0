# Rava — local / frontend environment (Vite)
# Copy to `.env.local` and fill values. Never commit `.env.local`.

# --- Supabase (client / anon only) ---
VITE_SUPABASE_URL=https://thmsfdugojokxtemnqdw.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Google (browser) ---
# Used by MainMap, routing (Maps JS Directions), Place details.
VITE_GOOGLE_MAPS_API_KEY=

# Gemini: NO client key. Live voice mints short-lived ephemeral tokens via the
# `mint-live-token` Edge Function; other AI calls use the `ai-complete` proxy.
# Server-side Edge Functions use the Supabase secret GEMINI_API_KEY (set in dashboard).
