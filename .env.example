# Rava — local / frontend environment (Vite)
# Copy to `.env.local` and fill values. Never commit `.env.local`.

# --- Supabase (client / anon only) ---
VITE_SUPABASE_URL=https://thmsfdugojokxtemnqdw.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Google (browser) ---
# Used by MainMap, routing (Routes library), Place details.
# TWO SEPARATE things (do not confuse):
#  1. Maps API KEY: for local dev use a Maps Demo Key or a billed project key with
#     Maps JavaScript API + Places API (New) + Routes API enabled, billing on,
#     and http://localhost:* (and 127.0.0.1) in the HTTP-referrer allow-list.
#     A key without billing FAILS with Permission Denied — no map will render.
#  2. Map ID: DEMO_MAP_ID (default when VITE_GOOGLE_MAPS_MAP_ID is empty) is only
#     a test Map ID; it does NOT replace a valid key. Production sets the styled
#     Map ID of the billed project here.
VITE_GOOGLE_MAPS_API_KEY=

# Cloud Map ID for AdvancedMarker. Production: styled Map ID of the billed project.
# Local dev: leave empty to use Google's public DEMO_MAP_ID.
# VITE_GOOGLE_MAPS_MAP_ID=

# Gemini: NO client key. Live voice mints short-lived ephemeral tokens via the
# `mint-live-token` Edge Function; other AI calls use the `ai-complete` proxy.
# Server-side Edge Functions use the Supabase secret GEMINI_API_KEY (set in dashboard).
